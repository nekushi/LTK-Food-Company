enum Role {
  ADMIN
  HR
  INVENTORY
  STORE
  DELIVERY
}

enum SupplierName {
  JB_Pila
  JB_Geo
  JB_Calamba
  JB_Pio
  Various_User
}

model Account {
  id        String  @id @default(uuid())
  firstName String
  lastName  String
  username  String
  password  String
  roleId    String?
  role      Role

  hr        HumanResource?
  inventory InventoryManager?
  store     Store?
  delivery  Delivery?
}

model Delivery {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      Account  @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model InventoryManager {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      Account  @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model HumanResource {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      Account  @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model Store {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      Account  @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  latitude  Float?
  longitude Float?

  requestItems RequestedItems[]
}

model Inventory {
  id                  String  @id @default(uuid())
  periodMonth         String
  periodYear          String
  supplierName        String
  tinNumber           String?
  typeOfVatTaxpayer   String?
  typeOfStocks        String
  productNameSpecific String
  productNameGeneral  String
  itemCode            String?
  accountRecognition  String
  unitOfMeasurement   String
  quantity            Int
  unitPrice           Float
  totalPrice          Float
  vatable             Float
  vat                 Float
  ewt                 Float
  netPay              Float
}

model RequestedItems {
  id                  String  @id @default(uuid())
  periodMonth         String
  periodYear          String
  supplierName        String
  tinNumber           String?
  typeOfVatTaxpayer   String?
  typeOfStocks        String
  productNameSpecific String
  productNameGeneral  String
  itemCode            String?
  accountRecognition  String
  unitOfMeasurement   String
  quantity            Int
  unitPrice           Float
  totalPrice          Float
  vatable             Float
  vat                 Float
  ewt                 Float
  netPay              Float
  isRequestApproved   Boolean @default(false)
  note                String?
  deliveryStatus      String?

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])
}

model Location {
  id        String   @id @default(uuid())
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
}

model Employee {
  id         String   @id @default(uuid())
  firstName  String
  lastName   String
  employeeId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  employeeData     EmployeeData?
  employeeWorkData EmployeeWorkData?
}

model EmployeeData {
  id         String   @id @default(uuid())
  dateHired  DateTime @default(now())
  sss        String?
  pagIbig    String?
  philhealth String?
  tin        String?
  contactNo  String?
  email      String?
  address    String?

  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model EmployeeWorkData {
  id         String   @id @default(uuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  data       Json[]
  // ...cardDatas
}
